import os
import replicate
from telegram import Update
from telegram.ext import (
    ApplicationBuilder,
    CommandHandler,
    ContextTypes,
    MessageHandler,
    filters,
)

TELEGRAM_TOKEN = "TVOJ_TELEGRAM_TOKEN"
os.environ["REPLICATE_API_TOKEN"] = "r8_TVOJ_REPLICATE_TOKEN"


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
  await update.message.reply_text("Ahoj! Som tvoj AI bot. Napíš mi správu.")


async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
  user_text = update.message.text
  await update.message.reply_text("Premýšľam...")

  try:
    output = replicate.run(
        "meta/meta-llama-3-70b-instruct", input={"prompt": user_text}
    )
    response = "".join(output)
    await update.message.reply_text(response)
  except Exception as e:
    await update.message.reply_text(f"Chyba: {e}")


if __name__ == "__main__":
  app = ApplicationBuilder().token(TELEGRAM_TOKEN).build()
  app.add_handler(CommandHandler("start", start))
  app.add_handler(
      MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message)
  )
  app.run_polling()
